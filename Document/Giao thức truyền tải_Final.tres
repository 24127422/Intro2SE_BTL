[resource]
script = ExtResource("2_2alo6")
ItemName = "Giao thức truyền tải_Final"
Icon = ExtResource("1_b5qaq")
Description = "`>> Đã chuyển đổi thành công.`
`>> Phân vùng gốc đã được truyền vào thiết bị mã S-2016N.`
`>> Thiết bị đích đang quá tải \"ký chủ\".`
`>> Tiến hành đóng băng dữ liệu... Thành công.`"
Thought = "Bố... cái gì đây? \"Ký chủ\"... chẳng lẽ mình chính là"
