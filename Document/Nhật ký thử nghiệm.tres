[resource]
script = ExtResource("2_wjscl")
ItemName = "Hồ sơ bệnh án Ân-Nguyễn-09"
Icon = ExtResource("1_eeaxj")
Description = "Báo cáo chẩn đoán, khoa Sản-Nhi (năm 2015). Bệnh nhân Nguyễn Phạm Thiên Ân bị suy tủy cấp do phơi nhiễm chất phóng xạ hoá chất không xác định. Nguồn lây nhiễm chưa được làm rõ.
Ghi chú lề (viết tay, mực đã phai): \"...xảy ra ngay sau khi bố cháu hoàn tất ca trực tại phòng lab tầng 11...\""
Thought = "Thiên Ân là con gái thầy Nguyễn. Tại sao em ấy lại nhiễm hoá chất độc hại ngay tại trường?
Có phải có ai đó đã cố tình làm chuyện này?"
IsDocument = true
metadata/_custom_type_script = "uid://brw8kiqnoijs6"
