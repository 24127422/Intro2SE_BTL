[ext_resource type="Script" uid="uid://brw8kiqnoijs6" path="res://scripts/Item.cs" id="2_wjscl"]

[resource]
script = ExtResource("2_wjscl")
ItemName = "New Volumn F"
Icon = ExtResource("1_eeaxj")
Description = "Thử nghiệm số 13. Sau khi cấy nhật , bản thân như được khai phá tiềm năng, việc học thuộc trở nên dễ dàng hơn, tốc độ xử lý thông tin được tăng mức đáng kể. Tuy nhiên nếu hoạt động quá mức, cơ thể sẽ cảm thấy nóng lên và tê liệt đôi chút. Có đôi khi tay cũng mất cảm giác tạm thời."
Thought = "Một dải liên kết 8 chân cắm, bề mặt có lớp men màu trắng ngà — giống hệt răng người. Ngửi thấy mùi canxi và ozone nồng nặc"
IsDocument = true
metadata/_custom_type_script = "uid://brw8kiqnoijs6"
