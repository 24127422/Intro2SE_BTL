[resource]
script = ExtResource("2_5ngcj")
ItemName = "Nhật ký giấu trong ngăn bàn của Giáo sư Nguyễn"
Icon = ExtResource("1_hugi8")
Description = "12/2016 - Con bé đã yếu đi nhiều. Bác sĩ nói nếu không có thuốc đặc trị, chỉ còn vài tháng.
3/2017 - Tôi đã làm. Tôi không xứng được gọi là bạn của anh nữa, Hoàng à.
3/2017 - Con bé vẫn không qua khỏi. Vesper nói \"chi phí vượt ngân sách phê duyệt\". Tôi đã đánh đổi tất cả để đổi lấy một lời hứa suông.
9/2026 - Thằng bé vào được vòng học bổng rồi. Trời ơi, tôi đang làm gì với cuộc đời nó vậy..."
Thought = "Vesper...
Bố..."
IsDocument = true
