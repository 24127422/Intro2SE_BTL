[resource]
script = ExtResource("2_5ngcj")
ItemName = "Bài đăng ẩn danh — HCMUS Confessions"
Icon = ExtResource("1_hugi8")
Description = "Có ai để ý là mấy anh chị nhận học bổng Vesper những năm trước, sau khi 'đi du học' thì  không ai còn liên lạc được nữa không? Kể cả confession cũ của họ trên page cũng bị xoá sạch. Search tên của họ trên Google chỉ ra đúng 0 kết quả sau năm nhận học bổng. Ai học Thánh địa tầng 11 xong đều bảo trong đó lạnh toát dù full điều hoà, kiểu... không phải lạnh do máy."
Thought = "Không phải chỉ mình mình thấy điều đó bất thường."
IsDocument = true
DocumentImage = ExtResource("1_41m3o")
