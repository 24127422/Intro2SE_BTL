[resource]
script = ExtResource("2_dg7hm")
ItemName = "Đơn xin thôi việc"
Icon = ExtResource("1_8bf7y")
Description = "Đơn xin nghỉ việc gửi Vesper, lý do: \"Tôi cảm thấy cơ thể ngày càng suy nhược từ khi bắt đầu sử dụng thiết bị công ty cấp...\" - con dấu \"ĐÃ XỬ LÝ\" đóng chồng lên, không có chữ ký phản hồi nào từ phía công ty."
Thought = "Đã xử lý\" bằng cách nào? Người này bây giờ ở đâu?"
IsDocument = true
