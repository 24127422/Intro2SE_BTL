[resource]
script = ExtResource("2_ptu5h")
ItemName = "Bài đăng ẩn danh - HCMUS Confessions"
Icon = ExtResource("1_qnwnw")
Description = "\"Có ai để ý là mấy anh chị nhận học bổng Vesper những năm trước, sau khi 'đi du học' thì không ai còn liên lạc được nữa không? 
Kể cả confession cũ cũng bị xoá sạch. Search tên trên Google 0 có kết quả luôn. 
Ai học Thánh địa tầng 11 xong đều bảo trong đó lạnh toát dù full điều hoà, kiểu... không phải lạnh do máy.\""
Thought = "Không phải chỉ mình mình thấy điều đó bất thường."
IsDocument = true
metadata/_custom_type_script = "uid://brw8kiqnoijs6"
