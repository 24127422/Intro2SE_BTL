[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
SpeakerName = "Máy tính cũ"
Text = "Màn hình sáng lên. Đó là gương mặt cha, đang cố mở mắt — và lần này, ông ấy thật sự nhận ra mình."

[resource]
