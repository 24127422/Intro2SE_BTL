[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
SpeakerName = "Máy tính cũ"
Text = "ROM khớp hoàn toàn. Đèn nguồn nhấp nháy một nhịp... rồi một nhịp nữa, như mạch đập thật sự."
